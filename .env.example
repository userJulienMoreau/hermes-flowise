# Copier vers .env (jamais commité) : cp .env.example .env

# Clé d'accès à l'API de Hermes (Bearer). 8 caractères minimum.
# Générer : openssl rand -hex 32
API_SERVER_KEY=

# Clé de chiffrement des credentials Flowise. À fixer, sinon
# « Credentials could not be decrypted » après recréation du conteneur.
# Générer : openssl rand -hex 32
FLOWISE_SECRETKEY_OVERWRITE=

# Connexion au tableau de bord web de Hermes (http://localhost:9119).
# Générer le mot de passe : openssl rand -base64 18
HERMES_DASHBOARD_USERNAME=admin
HERMES_DASHBOARD_PASSWORD=

# Clé API Flowise (Flowise > API Keys), utilisée par les tâches cron Hermes qui déclenchent un flow.
# Vide = flows appelés sans clé (acceptable seulement si le flow n'est pas protégé).
FLOWISE_API_KEY=

# Optionnel
# HERMES_IMAGE_TAG=stable      # stable | latest | main | X.Y.Z
# FLOWISE_IMAGE_TAG=3.1.3     # 3.1.4/latest plante au démarrage (connect-sqlite3)
# HERMES_API_PORT=8642
# FLOWISE_PORT=3000
