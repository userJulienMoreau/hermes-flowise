# Copier vers .env (jamais commité) : cp .env.example .env

# Clé d'accès à l'API de Hermes (Bearer). 8 caractères minimum.
# Générer : openssl rand -hex 32
API_SERVER_KEY=

# Clé de chiffrement des credentials Flowise. À fixer, sinon
# « Credentials could not be decrypted » après recréation du conteneur.
# Générer : openssl rand -hex 32
FLOWISE_SECRETKEY_OVERWRITE=

# Optionnel
# HERMES_IMAGE_TAG=stable      # stable | latest | main | X.Y.Z
# FLOWISE_IMAGE_TAG=latest
# HERMES_API_PORT=8642
# FLOWISE_PORT=3000
